{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "convex/**/*.ts",
    "shared/**/*.ts",
    "src/cloud/**/*.ts",
    "tests/**/*.ts",
    "packages/*/src/**/*.ts",
    "agent/**/*.ts",
    "examples/**/*.ts",
    "scripts/**/*.ts"
  ]
}
